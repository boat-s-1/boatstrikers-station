-- Isolated PostgreSQL 17 integration test. Creates only disposable CI database fixtures.
\set ON_ERROR_STOP on
CREATE ROLE anon NOLOGIN;
CREATE ROLE authenticated NOLOGIN;
CREATE ROLE service_role NOLOGIN;
CREATE TABLE public.bsc_results(id integer PRIMARY KEY, result text);
INSERT INTO public.bsc_results VALUES (1, 'fixture');
ALTER TABLE public.bsc_results ENABLE ROW LEVEL SECURITY;
GRANT USAGE ON SCHEMA public TO anon, authenticated, service_role;
GRANT SELECT, INSERT, UPDATE, DELETE ON public.bsc_results TO anon, authenticated, service_role;
CREATE POLICY bsc_select ON public.bsc_results FOR SELECT TO PUBLIC USING (true);
CREATE POLICY bsc_insert ON public.bsc_results FOR INSERT TO anon, authenticated WITH CHECK (true);
CREATE POLICY bsc_update ON public.bsc_results FOR UPDATE TO anon, authenticated USING (true) WITH CHECK (true);
CREATE POLICY bsc_delete ON public.bsc_results FOR DELETE TO anon, authenticated USING (true);
CREATE FUNCTION public.bsc_sync_official_results_to_legacy() RETURNS void
LANGUAGE sql SECURITY DEFINER AS 'SELECT NULL::void';
REVOKE ALL ON FUNCTION public.bsc_sync_official_results_to_legacy() FROM PUBLIC;
GRANT EXECUTE ON FUNCTION public.bsc_sync_official_results_to_legacy() TO service_role;
-- Capture the precise fixture state; never hardcode ACLs or function hashes.
\set s01_backup_verified yes
SELECT relowner::regrole::text AS s01_owner,
       relacl::text AS s01_table_acl
FROM pg_class WHERE oid='public.bsc_results'::regclass \gset
SELECT md5(pg_get_functiondef(oid)) AS s01_function_hash,
       proacl::text AS s01_function_acl
FROM pg_proc WHERE oid='public.bsc_sync_official_results_to_legacy()'::regprocedure \gset
SELECT coalesce(jsonb_agg(to_jsonb(x) ORDER BY policyname),'[]'::jsonb)::text AS s01_policy_manifest
FROM (SELECT policyname,permissive,roles,cmd,qual,with_check FROM pg_policies
      WHERE schemaname='public' AND tablename='bsc_results') x \gset
\i /tmp/pr297-apply.sql
DO $verify$
BEGIN
 IF (SELECT count(*) FROM pg_policies WHERE schemaname='public' AND tablename='bsc_results'
     AND cmd IN ('INSERT','UPDATE','DELETE')) <> 0
 THEN RAISE EXCEPTION 'S01 write policies remain'; END IF;
 IF NOT has_table_privilege('anon','public.bsc_results','SELECT')
 OR NOT has_table_privilege('authenticated','public.bsc_results','SELECT')
 THEN RAISE EXCEPTION 'S01 SELECT unexpectedly revoked'; END IF;
 IF has_table_privilege('anon','public.bsc_results','INSERT')
 OR has_table_privilege('authenticated','public.bsc_results','UPDATE')
 OR has_table_privilege('anon','public.bsc_results','DELETE')
 THEN RAISE EXCEPTION 'S01 write privileges remain'; END IF;
 IF NOT has_table_privilege('service_role','public.bsc_results','INSERT')
 THEN RAISE EXCEPTION 'S01 service_role lost write privilege'; END IF;
END $verify$;
SELECT 'S01 isolated apply: PASS' AS result;
