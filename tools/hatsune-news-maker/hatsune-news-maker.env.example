# BoatStrikers 初音ヴィーナスNEWS Maker 設定
# このファイルを hatsune-news-maker.env にコピーして値を設定してください。
# hatsune-news-maker.env はGitHubへ公開しないでください。

HATSUNE_NEWS_BASE_URL=https://www.boat-strike.online
HATSUNE_NEWS_ADMIN_SECRET=ここにVercelのHATSUNE_NEWS_ADMIN_SECRETを入力
HATSUNE_NEWS_SPEAKER_ID=ここに初音のAivisSpeech Style IDを入力

# 必要に応じて変更
AIVIS_API_URL=http://127.0.0.1:10101
HATSUNE_NEWS_SPEED=1.05
HATSUNE_NEWS_INTONATION=1.03
HATSUNE_NEWS_FONT=Yu Gothic

# 任意：立ち絵・BGM・SEをローカルファイルで指定
# HATSUNE_NEWS_IMAGE=C:\BoatStrikers\assets\hatsune.png
# HATSUNE_NEWS_BGM=C:\BoatStrikers\assets\venus-news-bgm.mp3
# HATSUNE_NEWS_SE=C:\BoatStrikers\assets\news-opening.mp3
